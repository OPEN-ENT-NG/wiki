{
  "name": "@edifice.io/wiki",
  "version": "3.6.21-develop-pedago.0",
  "description": "Wiki application",
  "license": "AGPL-3.0",
  "author": "Edifice",
  "type": "module",
  "scripts": {
    "build": "pnpm run typecheck && vite build && vite build --mode lib",
    "build-lib": "vite build --mode lib",
    "dev": "vite",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write .",
    "lint": "eslint .",
    "pre-commit": "lint-staged",
    "postinstall": "edifice-cli check-singletons",
    "prepare": "cd .. && husky frontend/.husky || true",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "pnpm run format",
      "pnpm run lint"
    ]
  },
  "dependencies": {
    "@react-spring/web": "9.7.5",
    "@uidotdev/usehooks": "2.4.1",
    "clsx": "2.1.1",
    "i18next": "23.16.8",
    "i18next-http-backend": "2.7.3",
    "lottie-react": "2.4.2",
    "ode-explorer": "develop-pedago",
    "react-hook-form": "7.92.0",
    "react-router-dom": "6.30.6",
    "zustand": "4.5.7"
  },
  "peerDependencies": {
    "@edifice.io/bootstrap": "*",
    "@edifice.io/client": "*",
    "@edifice.io/react": "*",
    "@tanstack/react-query": "^5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^14"
  },
  "devDependencies": {
    "@axe-core/react": "4.14.0",
    "@babel/plugin-transform-react-pure-annotations": "7.29.7",
    "@edifice.io/bootstrap": "develop-pedago",
    "@edifice.io/cli": "develop-pedago",
    "@edifice.io/client": "develop-pedago",
    "@edifice.io/react": "develop-pedago",
    "@eslint/js": "9.39.5",
    "@tanstack/react-query": "5.108.0",
    "@tanstack/react-query-devtools": "5.108.0",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "18.19.130",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.6",
    "@vitest/ui": "3.2.6",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "15.15.0",
    "husky": "9.1.7",
    "jsdom": "25.0.1",
    "lint-staged": "15.5.2",
    "msw": "2.15.0",
    "nx": "19.8.14",
    "prettier": "3.10.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "14.1.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "5.4.21",
    "vite-plugin-dts": "4.5.4",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.6"
  },
  "resolutions": {
    "katex": "0.16.33"
  },
  "exports": {
    "./lib": {
      "import": "./lib/index.js",
      "types": "./lib/index.d.ts"
    }
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10"
  },
  "pnpm": {
    "overrides": {
      "rollup": "4.68.5"
    }
  },
  "nx": {}
}